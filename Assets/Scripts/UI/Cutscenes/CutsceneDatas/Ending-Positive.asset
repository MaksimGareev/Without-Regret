%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84bc8b7b4e1963c4fba94977599534a1, type: 3}
  m_Name: Ending-Positive
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  clips:
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Echo!
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: Chime...is that you?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Are you okay?! You were corrupted, I had to fight this awful version
        of you.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: I...couldn't control myself. Everything came back to me. You pulled me
        in here to help you get your body back and try to find a way out, right?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: ...those are some of the reasons, yes. I'm so sorry, Echo. I didn't want
        you to find out this way.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 6
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: No, I'm sorry...I should've died in the forest instead of you.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 6
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Don't say that! How could you say such an awful thing, Echo?!
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 12
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: You were the light of everyone's lives, Chime. I'm a fly on the wall.
        The world was a brighter place with you in it. I made no real difference.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: You made all the difference to me, Echo! I was only ever able to smile
        because you were keeping me from falling apart!
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: Anyone would've been there for you...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: NOBODY was there for me like you were. Why do you think I pulled you
        in out of everyone? You mean so much to me and many others, Echo. Please,
        try to see that...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: ...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 12
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: You're right. I'm so sorry, Chime. It took so much for me to see. Now
        that we're together again, can we go home?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: If you mean going back to our original world, the one before the Astral
        Plane, I'm afraid we can't...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 1
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: We can, however, move on to the next one, together, wherever it may be.
        Are you ready?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  canSkipEntireCutscene: 0
  backgroundMusic: {fileID: 8300000, guid: 619550a60a9780d418717bd7f4202e00, type: 3}
  musicVolume: 1
  onCutsceneCompleted:
    m_PersistentCalls:
      m_Calls: []
