%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84bc8b7b4e1963c4fba94977599534a1, type: 3}
  m_Name: Ending-Neutral
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  fadeIn: 1
  canSkipEntireCutscene: 0
  clips:
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Echo!
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 3
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: Chime?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Are you okay?! You were corrupted, I had to fight this awful version
        of you.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: I...couldn't control myself. Everything came back to me. You pulled me
        in here...I can't believe I forgot about you...about our time together.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 6
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: I'm so sorry, Echo. I didn't want you to find out this way.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: You didn't want me to find out that we were best friends and that I'd
        lost you? I don't understand.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: It's not that simple, Echo. I called to you from the other side, here
        in the Astral Plane, I waited years...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: Correct me if I'm wrong, but you pulled me in here with the goal of helping
        you, but a side effect of the means you used was giving me amnesia?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Yes. I wanted to find the right time to tell you everything, but by the
        time the rumbling started and you had touched the tree...everything just
        moved so fast.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 6
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: Why me? Someone else could have helped you more, don't you think?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Why you? Echo...nobody else meant as much to me as you did, as you do.
        All the time we spent together, the memories we made? Who else would I have
        called?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 15
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: ...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Echo
      NPCGender: 1
      text: I just can't understand why you'd go out of your way to do all this.
        Why couldn't I have just stayed back? Was my time up?
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Oh, Echo...you still haven't learnt the lesson. You still don't know
        how much you meant to me, how much good you gave to the world.
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  - backgroundType: 2
    backgroundImage: {fileID: 0}
    solidColor: {r: 0, g: 0, b: 0, a: 0}
    duration: 9
    autoContinue: 0
    canSkipClipEarly: 0
    dialogueLine:
      Speaker: Chime
      NPCGender: 1
      text: Maybe...when you close your eyes...you'll figure it out...in the next...
    clipSoundEffect: {fileID: 0}
    soundEffectVolume: 1
  backgroundMusic: {fileID: 8300000, guid: 619550a60a9780d418717bd7f4202e00, type: 3}
  musicVolume: 1
  onCutsceneCompleted:
    m_PersistentCalls:
      m_Calls: []
