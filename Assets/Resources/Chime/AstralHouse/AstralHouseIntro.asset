    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Part II confused
    Speaker: Chime
    text: Hey! There's no need to be rude...we're more acquainted than you think.
    lineTone: 2
    NPCGender: female
    NextLineID: Part II
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
