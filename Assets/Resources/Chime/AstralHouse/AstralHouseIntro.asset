    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Bad E 1
    Speaker: Echo
    text: Yeah, I'm awake now. Mind telling me who the f*#% you are?!
    lineTone: 2
    NPCGender: female
    NextLineID: Part II confused
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Bad E 2
    Speaker: Echo
    text: Where am I? Who are you? Get away from me.
    lineTone: 0
    NPCGender: female
    NextLineID: Part II get away
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
