  - LineID: Good E I
    Speaker: Echo
    text: Okay...what exactly is this 'Astral Plane' that I'm in now?
    lineTone: 0
    NPCGender: female
    NextLineID: Part III
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
