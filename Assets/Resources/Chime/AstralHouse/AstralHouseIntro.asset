    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Good E Two
    Speaker: Echo
    text: I can't confidently say I'll succeed, but I'll give it my best shot.
    lineTone: 1
    NPCGender: female
    NextLineID: Good
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
