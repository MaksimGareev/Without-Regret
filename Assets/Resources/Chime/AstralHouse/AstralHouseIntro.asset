  - LineID: Good E One
    Speaker: Echo
    text: If it's for my friends, then yes, I absolutely can!
    lineTone: 1
    NPCGender: female
    NextLineID: Good
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
