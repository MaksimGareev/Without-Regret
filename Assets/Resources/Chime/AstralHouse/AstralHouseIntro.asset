  - LineID: Part III sleep
    Speaker: Chime
    text: Are you serious?! You can take a nap later, pay attention!
    lineTone: 2
    NPCGender: female
    NextLineID: Part III
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
