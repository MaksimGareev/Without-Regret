    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Bad E I
    Speaker: Echo
    text: Uh-huh. Cool. Can I go back to sleep now? Was having this really awesome
      dream where-
    lineTone: 1
    NPCGender: female
    NextLineID: Part III sleep
