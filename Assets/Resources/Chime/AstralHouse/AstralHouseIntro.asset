  m_Script: {fileID: 11500000, guid: 5e28c2e20bb6c4240a55d8edffb777ec, type: 3}
  m_Name: AstralHouseIntro
  m_EditorClassIdentifier: Assembly-CSharp::NewDialogueData
  npcName: Chime
  dialogueLines:
  - LineID: Start
    Speaker: Chime
    text: Oh! You finally woke up.
    lineTone: 1
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: Why does everything look strange?
      NextLineID: Good E 1
      moralityChange: 1
      direction: 3
      objectiveToActivate: 
    - text: Who the **** are you?!
      NextLineID: Bad E 1
      moralityChange: -1
      direction: 1
      objectiveToActivate: 
    - text: Shouldn't have eaten those berries.
      NextLineID: Good E 2
      moralityChange: 1
      direction: 2
      objectiveToActivate: 
    - text: Get away from me.
      NextLineID: Bad E 2
      moralityChange: -1
      direction: 0
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Part II
    Speaker: Chime
    text: I'm not in my usual form, and it seems you don't remember me, but I'll
      do my best to explain. My name is Chime, your guiding fairy, and we're in a
      place called The Astral Plane now. I pulled you in here, this is the Astral
      form of your house.
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: What is the Astral Plane?
      NextLineID: Good E I
      moralityChange: 1
      direction: 3
      objectiveToActivate: 
    - text: Doesn't make things any clearer.
      NextLineID: Neutral E I
      moralityChange: 0
      direction: 1
      objectiveToActivate: 
    - text: Can I go back to sleep?
      NextLineID: Bad E I
      moralityChange: -1
      direction: 0
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Part III
    Speaker: Chime
    text: The astral plane is an afterlife, of sorts, but a disturbed one. Your friends
      and others are stuck in traumatic loops of their deaths. Since I pulled you
      in, you've gotten powers from my energy. I'm here to guide you, so you can
      use those powers to break tormented souls free.
    lineTone: 0
    NPCGender: female
    NextLineID: Part IV
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Part IV
    Speaker: Chime
    text: Earlier today, your friends spoke of the people they lost, and how they
      wish they could have changed the past. Here, you can do just that, as a mediator
      of sorts.
    lineTone: 0
    NPCGender: female
    NextLineID: Part V
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Part V
    Speaker: Chime
    text: Can you help your friends move forward, without regret?
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: Yes, I can!
      NextLineID: Good E One
      moralityChange: 1
      direction: 0
      objectiveToActivate: 
    - text: I'm not sure, but I'll try.
      NextLineID: Good E Two
      moralityChange: 1
      direction: 2
      objectiveToActivate: 
    - text: I've got my own problems.
      NextLineID: Bad E One
      moralityChange: -1
      direction: 1
      objectiveToActivate: 
    - text: I JUST woke up.
      NextLineID: Bad E Two
      moralityChange: -1
      direction: 3
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Good
    Speaker: Chime
    text: That's the spirit! Let's get going.
    lineTone: 1
    NPCGender: female
    NextLineID: End
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Bad
    Speaker: Chime
    text: Helping the others will fix your biggest problem. Just trust me.
    lineTone: 0
    NPCGender: female
    NextLineID: End
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: End
    Speaker: Chime
    text: We'll have to go through a gate in The Graveyard. When you're ready, we'll
      head out.
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 1
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Good E 1
    Speaker: Echo
    text: Hello, weird fairy...moth...thing? Could you tell me why everything looks
      as if I'm seeing it through a fishbowl?
    lineTone: 0
    NPCGender: female
    NextLineID: Part II
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Good E 2
    Speaker: Echo
    text: You know, being around a forest my whole life, I should've known better
      than to eat those berries.
    lineTone: 0
    NPCGender: female
    NextLineID: Part II berries
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
