    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Part II berries
    Speaker: Chime
    text: This isn't a wild berry hallucination, silly!
    lineTone: 1
    NPCGender: female
    NextLineID: Part II
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
