  npcName: Chime
  dialogueLines:
  - LineID: First
    Speaker: Chime
    text: The fog on this path is too suffocating to walk through, if we linger in
      there for too long we'll be lost to this forest.
    lineTone: 0
    NPCGender: female
    NextLineID: Second
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    choices: []
    objectivesToActivate: []
  - LineID: Second
    Speaker: Chime
    text: 'Let''s try and find another way around. I saw a path near the forest sign
      we passed by, we can try to go through there. '
    lineTone: 0
    NPCGender: female
    NextLineID: Second
    endDialogueAfterLine: 1
