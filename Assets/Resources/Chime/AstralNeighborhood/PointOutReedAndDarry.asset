  - LineID: Part II
    Speaker: Chime
    text: ...It looks like he's arguing with someone, do you know who that is?
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
