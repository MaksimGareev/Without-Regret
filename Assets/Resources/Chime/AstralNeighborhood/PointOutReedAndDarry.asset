    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: Yeah, that's Darry.
      NextLineID: E Good I
      moralityChange: 1
      direction: 0
      objectiveToActivate: 
    - text: Dunno. Wasn't listening.
      NextLineID: E Bad I
      moralityChange: -1
      direction: 1
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Good
    Speaker: Chime
    text: So that's the friend he was mourning in The Graveyard, you should see why
