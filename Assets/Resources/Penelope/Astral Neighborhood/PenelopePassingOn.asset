  m_Script: {fileID: 11500000, guid: 5e28c2e20bb6c4240a55d8edffb777ec, type: 3}
  m_Name: PenelopePassingOn
  m_EditorClassIdentifier: Assembly-CSharp::NewDialogueData
  npcName: Penelope
  dialogueLines:
  - LineID: Start
    Speaker: Penelope
    text: (Panting) I'm finally out of the forest...I can finally tell Irene...
    lineTone: 0
    NPCGender: female
    NextLineID: Part II
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Part II
    Speaker: Penelope
    text: Wait, what's going on? Who are y-...Echo?! What're you doing here?
    lineTone: 0
    NPCGender: female
    NextLineID: Part III
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Part III
    Speaker: Penelope
    text: I feel strange...like I could float away. Please, what's going on??
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: Breathe, you're okay.
      NextLineID: Breathe
      moralityChange: 1
      direction: 1
      objectiveToActivate: 
    - text: Calm down.
      NextLineID: Calm Down
      moralityChange: -1
      direction: 0
      objectiveToActivate: 
    - text: I could really use a wish right now.
      NextLineID: Airplanes
      moralityChange: 1
      direction: 3
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Breathe
    Speaker: Echo
    text: Breathe, Penelope. I know it's scary, but you're okay. Give me a minute,
      I'll explain.
    lineTone: 0
    NPCGender: female
    NextLineID: Trust
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Calm Down
    Speaker: Echo
    text: Calm down. I can't hear myself think. If you give me 2 seconds, I'll tell
      you what's going on.
    lineTone: 0
    NPCGender: female
    NextLineID: Sorry
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Trust
    Speaker: Penelope
    text: Okay, I'm trusting you Echo. Where are we, what's going on?
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: I'm so sorry...
      NextLineID: Nice
      moralityChange: 1
      direction: 1
      objectiveToActivate: 
    - text: I can't be bothered...
      NextLineID: Mean
      moralityChange: -1
      direction: 0
      objectiveToActivate: 
    - text: What do I even say?
      NextLineID: Neutral Point
      moralityChange: 0
      direction: 2
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Sorry
    Speaker: Penelope
    text: I'm sorry. I'm just really scared. Please, what's happening?
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: I'm so sorry...
      NextLineID: Nice
      moralityChange: 1
      direction: 0
      objectiveToActivate: 
    - text: I can't be bothered...
      NextLineID: Mean
      moralityChange: -1
      direction: 1
      objectiveToActivate: 
    - text: What do I even say?
      NextLineID: Neutral Point
      moralityChange: 0
      direction: 2
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Nice
    Speaker: Echo
    text: I'm sorry Penelope, but you've passed away. You've been dead for some time
      now...
    lineTone: 0
    NPCGender: female
    NextLineID: Nice II
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Nice II
    Speaker: Echo
    text: This place we're in, while it looks just like back home, it's actually
      an afterlife of sorts, called The Astral Plane.
    lineTone: 0
    NPCGender: female
    NextLineID: Nice III
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Nice III
    Speaker: Penelope
    text: Afterlife? So I'm...you're right...I remember now. I was hurting after
      the accident, I could barely see...I couldn't get out of the forest.
    lineTone: 0
    NPCGender: female
    NextLineID: Next
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Next
    Speaker: Penelope
    text: Echo. I'm not ready. I have so many questions! Why am I just seeing you
      now?! Can I say sorry to Irene?! What's going to happen?!
    lineTone: 2
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: Irene misses you every day.
      NextLineID: E Good I
      moralityChange: 2
      direction: 1
      objectiveToActivate: 
    - text: Getting you out was tough.
      NextLineID: E Bad I
      moralityChange: -2
      direction: 3
      objectiveToActivate: 
    - text: I'm not very good at this...
      NextLineID: E Neutral I
      moralityChange: 0
      direction: 0
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: E Good I
    Speaker: Echo
    text: If you're wondering if Irene grew to hate you...you never had anything
      to worry about. She visits your grave every day, and cries every time. You
      didn't make it through the forest in a past life, but it's different now. You
      can move on from here.
    lineTone: 1
    NPCGender: female
    NextLineID: Happy End
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: E Neutral I
    Speaker: Echo
    text: You know, this isn't the first time I try to help someone through this
      process. You'd think I'd get better at it, but clearly, I haven't. I'm sorry
      Penelope, I really don't know what to say. I'm sure what's next for you, wherever
      it is, will be good...hopefully...
    lineTone: 0
    NPCGender: female
    NextLineID: Neutral End
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: E Bad I
    Speaker: Echo
    text: Penelope, nice to see you again, whatever. With that out of the way, it
      was quite difficult getting you through the Astral Forest in one piece. I've
      secured your way out of here, something I'm not even sure I'll be able to do.
      Do you have anything useful on you, as a thanks for my hard work?
    lineTone: 2
    NPCGender: female
    NextLineID: Negative End
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Happy End
    Speaker: Penelope
    text: Echo, you're so sweet. I still don't fully undertand what's going on, but
      I know you're not lying, I know you're right. I feel it. Hopefully, Irene can
      find me on the other side when it's her time, and I'll be able to tell her
      everything I couldn't. Till then, thank you, Echo.
    lineTone: 1
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 1
    movingOn: 1
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Neutral End
    Speaker: Penelope
    text: Aw, Echo. It's okay, I appreciate you trying. I'm sure this is just as
      confusing for you as it is for me, so I appreciate your kind words. I don't
      know what's next for me, but I hope to see Irene, and eventually, you there
      too. Thank you, Echo. Take care!
    lineTone: 1
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 1
    movingOn: 1
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Negative End
    Speaker: Penelope
    text: Echo...are you serious? I appreciate that you've been watching over me,
      but I'm about to go some place neither of us can even fathom, and you're asking
      for some kind of payment? You're definitely not the Echo I used to know...thanks
      for helping, I guess.
    lineTone: 2
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 1
    movingOn: 1
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 1
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Airplanes
    Speaker: Echo
    text: Could we pretend that airplanes in the night sky are like shooting stars...I'm
      sorry. Bad timing. You're okay, Penelope. Please just trust me and I'll explain
      it as best I can to you.
    lineTone: 1
    NPCGender: female
    NextLineID: Trust Funny
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Trust Funny
    Speaker: Echo
    text: It's okay, it kind of cheered me up. Thanks for that.
    lineTone: 1
    NPCGender: female
    NextLineID: Trust
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Mean
    Speaker: Echo
    text: Man, I do NOT want to have to explain this whole Astral Plane thing...basically,
      we're in the afterlife. You're here because you passed away, I'm here because
      a weird moth fairy thing pulled me in.
    lineTone: 2
    NPCGender: female
    NextLineID: Nice III
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
  - LineID: Neutral Point
    Speaker: Echo
    text: Wow, uhh...where do I even start. This place, the Astral Plane, is an afterlife.
      I was brought here by a moth fairy thing named Chime, and you're here because
      you passed away some years ago...yeah...
    lineTone: 0
    NPCGender: female
    NextLineID: Nice III
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices: []
    objectivesToActivate: []
