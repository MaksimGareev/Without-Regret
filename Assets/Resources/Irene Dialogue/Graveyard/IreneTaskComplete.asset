  - LineID: Story III
    Speaker: Irene
    text: I tried warning her about going out that night. She didn't listen, but
      I still can't help but feel that it's my fault.
    lineTone: 0
    NPCGender: female
    NextLineID: 
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
    playSFXOnstart: 0
    SFX: {fileID: 0}
    spawnCollectible: 0
    collectablePrefab: {fileID: 0}
    spawnPointID: 
    collectableSpawnID: 
    collectableData: {fileID: 0}
    choices:
    - text: You can't blame yourself.
      NextLineID: Good E 1
      moralityChange: 1
      direction: 0
      objectiveToActivate: 
    - text: She'd never think that.
      NextLineID: Good E 2
      moralityChange: 1
      direction: 3
      objectiveToActivate: 
    - text: Why didn't you go?
      NextLineID: Bad E 1
      moralityChange: -1
      direction: 1
      objectiveToActivate: 
    - text: That's silly.
      NextLineID: Bad E 2
      moralityChange: -1
      direction: 2
      objectiveToActivate: 
    objectivesToActivate: []
  - LineID: Good II
    Speaker: Irene
    text: I know, I know. It's just hard...but thanks, Echo.
    lineTone: 0
    NPCGender: female
    NextLineID: Story IV
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
