    objectivesToActivate: []
  - LineID: Bad II
    Speaker: Irene
    text: I ask myself that every day, Echo. If you hate being here with me so much,
      why'd you even come?
    lineTone: 0
    NPCGender: female
    NextLineID: Story IV
    endDialogueAfterLine: 0
    movingOn: 0
    GiveItem: 0
    ShakeCamera: 0
    cannotSkip: 0
